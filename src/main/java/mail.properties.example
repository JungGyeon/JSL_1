# 이 파일을 복사해서 같은 위치(src/main/java 바로 아래)에 mail.properties 라는 이름으로 저장한 뒤,
# 아래 값을 실제 발신용 계정 정보로 채워 넣으세요.
#
# mail.properties는 .gitignore에 등록되어 있어서 깃허브에는 올라가지 않습니다.
# 이 파일이 없거나 값이 비어 있으면 MailSender가 자동으로 콘솔 로그 모드로 동작합니다.

# ---- Gmail을 쓸 경우 ----
# Google 계정 > 보안 > 2단계 인증을 켠 뒤 "앱 비밀번호"를 발급받아 아래 password에 사용하세요.
# (일반 로그인 비밀번호는 사용할 수 없습니다.)
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.user=YOUR_ACCOUNT@gmail.com
mail.smtp.password=YOUR_APP_PASSWORD

# ---- 네이버 메일을 쓸 경우 (위 4줄을 지우고 아래 주석을 해제) ----
# 네이버 메일 > 환경설정 > POP3/IMAP 설정에서 "POP3/SMTP 사용"을 먼저 켜야 합니다.
# mail.smtp.host=smtp.naver.com
# mail.smtp.port=587
# mail.smtp.user=YOUR_ID@naver.com
# mail.smtp.password=YOUR_NAVER_PASSWORD
