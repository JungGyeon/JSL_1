# 이 파일을 복사해서 같은 위치(src/main/java 바로 아래)에 oauth.properties 라는 이름으로 저장한 뒤,
# 아래 값들을 실제로 발급받은 값으로 채워 넣으세요.
#
# oauth.properties는 .gitignore에 등록되어 있어서 깃허브에는 올라가지 않습니다.
# (Client Secret은 절대 커밋하면 안 되는 값입니다.)

google.client.id=YOUR_GOOGLE_CLIENT_ID
google.client.secret=YOUR_GOOGLE_CLIENT_SECRET
google.redirect.uri=http://localhost:8081/Project_1/oauth/google/callback

line.channel.id=YOUR_LINE_CHANNEL_ID
line.channel.secret=YOUR_LINE_CHANNEL_SECRET
line.redirect.uri=http://localhost:8081/Project_1/oauth/line/callback

kakao.rest.api.key=YOUR_KAKAO_REST_API_KEY
kakao.client.secret=kakao.client.secret=ddeDnA53jx5yPOW8tyRz1V8YERg5J1eq
kakao.redirect.uri=http://localhost:8081/Project_1/oauth/kakao/callback
